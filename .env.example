# Target Environment (dev | staging)
ENV=dev

# Application Endpoints
BASE_URL=https://learnify.io.vn
API_URL=https://learnify-be.onrender.com/graphql
DB_URL=

# Admin Credentials (used by user_cleanup fixture in conftest.py)
# NOTE: Set real values in your local .env file or GitHub Secrets. DO NOT commit real credentials.
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password

# Playwright Settings
HEADLESS=true
DEFAULT_TIMEOUT=30000

