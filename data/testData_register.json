{
  "happy_path": [
    {
      "test_name": "[REG-001] Successful register with valid credentials",
      "credentials": {
        "first_name": "testuser8",
        "last_name": "testuser8",
        "email": "testuser13@gmail.com",
        "password": "Password@123!"
      },
      "expected_e2e_response": {
        "url": "**/learner/dashboard/**",
        "page_title": "Dashboard |  Learnify for Learner"
      },
      "expected_ui_response": {
        "url": "/auth/sign-up",
        "page_title": "Sign Up - Learnify",
        "message": "Check your inbox!"
      },
      "expected_api_response": {
        "status_code": 200,
        "success": true,
        "message": "Tài khoản đang chờ kích hoạt. Hệ thống vừa gửi lại email, vui lòng kiểm tra."
      }
    }
  ],
  "e2e_register_login": [
    {
      "test_name": "Successful register with valid credentials then verify, login and logout",
      "credentials": {
        "first_name": "testuser11",
        "last_name": "testuser11",
        "email": "testuser18@gmail.com",
        "password": "123456789"
      },
      "expected_ui_response": {
        "url": "**/learner/dashboard*",
        "page_title": "Dashboard |  Learnify for Learner"
      },
      "expected_logout_response": {
        "url": "/auth/log-in",
        "page_title": "Log in |  Learnify for Learner"
      },
      "expected_api_response": {
        "status_code": 200,
        "message": "Login successful"
      }
    }
  ],
  "unhappy_path": [
    {
      "test_name": "[REG-002a] Register with empty first name fields",
      "credentials": {
        "first_name": "",
        "last_name": "rgergewg",
        "email": "ergwge@gmail.com",
        "password": "ntynrtn",
        "confirm_password": "ntynrtn"
      },
      "expected_ui_response": {
        "isHtml5Validation": false,
        "error_message": "First name must be at least 2 characters"
      }
    },
    {
      "test_name": "[REG-002b] Register with empty last name fields",
      "credentials": {
        "first_name": "rgergewg",
        "last_name": "",
        "email": "ergwge@gmail.com",
        "password": "ntynrtn",
        "confirm_password": "ntynrtn"
      },
      "expected_ui_response": {
        "isHtml5Validation": false,
        "error_message": "Last name must be at least 2 characters"
      }
    },
    {
      "test_name": "[REG-002c] Register with empty email fields",
      "credentials": {
        "first_name": "rgergewg",
        "last_name": "erbewef",
        "email": "",
        "password": "ntynrtn",
        "confirm_password": "ntynrtn"
      },
      "expected_ui_response": {
        "isHtml5Validation": false,
        "error_message": "Invalid email address"
      }
    },
    {
      "test_name": "[REG-004] Register with mismatched passwords",
      "credentials": {
        "first_name": "Lê Minh",
        "last_name": "Nguyệt",
        "email": "validemail@gmail.com",
        "password": "Password@123!",
        "confirm_password": "Password@999!"
      },
      "expected_ui_response": {
        "isHtml5Validation": false,
        "error_message": "Passwords do not match"
      }
    },
    {
      "test_name": "[REG-007] Register with existing email",
      "credentials": {
        "first_name": "Lê Minh",
        "last_name": "Nguyệt",
        "email": "testuser1@gmail.com",
        "password": "Password@123!"
      },
      "expected_ui_response": {
        "isHtml5Validation": false,
        "message": "Check your inbox!"
      },
      "expected_api_response": {
        "status_code": 200,
        "success": false,
        "message": "Email đã tồn tại trong hệ thống."
      }
    }
  ],
  "api_only_path": [
    {
      "test_name": "[REG-005] API Register with existing account",
      "credentials": {
        "username": "leminhnguyet_api",
        "email": "leminhnguyet.api@gmail.com",
        "password": "Password@123!",
        "phoneNumber": "+84987654321"
      },
      "expected_api_response": {
        "success": true,
        "message": "Tài khoản đang chờ kích hoạt. Hệ thống vừa gửi lại email, vui lòng kiểm tra."
      }
    }
  ]
}
